# Aarogya Seva Backend Environment Configuration

# Application Environment: development, staging, production
ENVIRONMENT=development

# Database Connection (SQLite for local dev, PostgreSQL for production)
# Local SQLite example: sqlite:///./aarogya_seva.db
# Render PostgreSQL example: postgresql://aarogya_user:password@dpg-xxxx.render.com/aarogya_db
DATABASE_URL=sqlite:///./aarogya_seva.db

# Authentication & Security
# Generate a strong 32+ character random key in production: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
# In production on Render, set this to your Vercel frontend URL, e.g.:
# CORS_ORIGINS=https://aarogya-seva.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Cookie Security (set to True in production when served over HTTPS)
COOKIE_SECURE=False
COOKIE_NAME=aarogya_session

